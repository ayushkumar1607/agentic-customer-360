# =============================================================================
# Agentic Customer 360 — Environment Template
# =============================================================================
# Copy this file to `.env` and fill in the real values:
#
#     cp .env.example .env
#
# `.env` is gitignored. Only `.env.example` is committed.
# =============================================================================

# ===== LLM (Groq) =====
# Get a free API key at: https://console.groq.com/keys
# The pipeline will not run without GROQ_API_KEY set.
GROQ_API_KEY=your_groq_api_key_here

# Model tiers — used by src/agents/base_agent.py, resolved via config/agents.yaml
#   fast   → swarm extraction agents (Usage, Support, Transaction, KYC)
#   reason → Life-Event, Synthesis, Action, Critique, Judge
#   alt    → Growth debate persona (for genuine divergence from Retention)
GROQ_MODEL_FAST=openai/gpt-oss-20b
GROQ_MODEL_REASON=openai/gpt-oss-120b
GROQ_MODEL_ALT=qwen/qwen3.6-27b

# ===== Optional: Hugging Face =====
# Not required. Only set if you want higher rate limits on embedding downloads
# or plan to use a HF sentiment classifier instead of the LLM path.
HF_API_KEY=
HF_SENTIMENT_MODEL=cardiffnlp/twitter-roberta-base-sentiment-latest

# ===== Paths =====
# All paths are relative to the project root.
DATA_RAW_PATH=./data/raw
DATA_PROCESSED_PATH=./data/processed
CHROMA_DB_PATH=./data/chroma
OUTPUT_PATH=./output
INFERRED_EVENTS_FILE=./output/inferred-events.jsonl

# ===== Logging =====
# One of: DEBUG, INFO, WARNING, ERROR, CRITICAL
# INFO is recommended for demos — shows every agent invocation, tool call,
# and stage handoff. Set to WARNING to silence per-event guardrail spans.
LOG_LEVEL=INFO

# ===== Memory decay =====
# Decay formula (src/memory/decay.py):
#     A(m, t) = W_base * exp(-lambda * (t - t_event)) * (1 + R_reinforce)
#
# lambda controls how fast memories lose influence. Units are 1/day.
#   0.01 → slow decay (memories relevant for ~3 months)
#   0.05 → moderate decay (~1 month)
#   0.10 → fast decay (~2 weeks)
MEMORY_DECAY_LAMBDA=0.01

# Base importance multiplier applied to every memory.
# 1.0 = no boost. Increase to keep histories more influential.
MEMORY_BASE_WEIGHT=1.0